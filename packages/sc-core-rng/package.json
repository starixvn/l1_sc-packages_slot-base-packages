{
    "name": "@sc/core-rng",
    "version": "1.0.0-beta.0",
    "description": "Secure RNG core functions for games using node:crypto",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --ci --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "reg": "npm set registry http://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry http://npm.lumigame.com --tag beta"
    },
    "keywords": [
        "rng",
        "crypto",
        "secure",
        "random",
        "shuffle"
    ],
    "files": [
        "dist/"
    ],
    "author": "",
    "license": "ISC",
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-report.xml",
        "indent": 4
    },
    "publishConfig": {
        "registry": "http://npm.lumigame.com"
    }
}
