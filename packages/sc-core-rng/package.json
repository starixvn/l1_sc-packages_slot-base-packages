{
    "name": "@sc/core-rng",
    "version": "1.0.3-beta.5",
    "description": "Secure RNG core functions for games using node:crypto",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "rimraf dist && tsc",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --ci --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "reg": "npm set registry http://npm.lumigame.com",
        "pub": "npm publish --registry http://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry http://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "keywords": [
        "rng",
        "crypto",
        "secure",
        "random",
        "shuffle"
    ],
    "files": [
        "dist/"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^8.57.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.24",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "jest-junit": "^16.0.0",
        "jest-sonar-reporter": "^2.0.0",
        "rimraf": "^5.0.5",
        "semantic-release": "^21.1.2",
        "ts-jest": "^29.1.2",
        "typescript": "^5.3.3"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-report.xml",
        "indent": 4
    },
    "publishConfig": {
        "registry": "http://npm.lumigame.com"
    }
}
