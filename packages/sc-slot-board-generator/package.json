{
    "name": "@sc/slot-board-generator",
    "version": "1.0.2-beta.7",
    "description": "Slot Board Generator",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix  && prettier --write '{src}/**/*.ts'",
        "prebuild": "rimraf dist",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "reg": "npm set registry http://npm.lumigame.com",
        "pub": "npm publish --registry http://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry http://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "files": [
        "dist/"
    ],
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/sc-packages/sc-slot-board-generator.git"
    },
    "keywords": [
        "board-generator",
        "sc-slot-board-generator"
    ],
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "license": "ISC",
    "dependencies": {
        "ramda": "^0.28.0",
        "@sc/core-rng": "workspace:*"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/gitlab": "^6.0.4",
        "@semantic-release/npm": "^7.0.5",
        "@semantic-release/release-notes-generator": "^9.0.1",
        "@types/jest": "^27.0.0",
        "@types/ramda": "^0.28.12",
        "babel-jest": "^27.0.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^27.0.0",
        "jest-extended": "^0.11.5",
        "jest-micro-auto-stub": "^1.0.7",
        "jest-sonar-reporter": "^2.0.0",
        "rimraf": "^3.0.2",
        "sc-semantic-release": "^1.2.0",
        "semantic-release": "^17.1.1",
        "ts-jest": "^27.1.4",
        "typescript": "^4.6.3"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "publishConfig": {
        "registry": "http://npm.lumigame.com"
    }
}
